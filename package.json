{
  "name": "teal-mobile-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:build": "cd android && ./gradlew assembleRelease",
    "android:build:dev": "cd android && ./gradlew assembleDebug",
    "android:build:dev:clean": "cd android && ./gradlew clean assembleDebug",
    "android:build:dev:clean:archive": "cd android && ./gradlew clean assembleDebug -Pandroid.injected.build.api=33",
    "android:build:dev:clean:archive:install": "cd android && ./gradlew clean assembleDebug -Pandroid.injected.build.api=33 install",
    "android:build:dev:clean:archive:install:uninstall": "cd android && ./gradlew clean assembleDebug -Pandroid.injected.build.api=33 install -Pandroid.injected.build.api=33 uninstall",
    "android:build:dev:clean:archive:install:uninstall:run": "cd android && ./gradlew clean assembleDebug -Pandroid.injected.build.api=33 install -Pandroid.injected.build.api=33 uninstall && react-native run-android",
    "android:build:dev:clean:archive:install:uninstall:run:debug": "cd android && ./gradlew clean assembleDebug -Pandroid.injected.build.api=33 install -Pandroid.injected.build.api=33 uninstall && react-native run-android --variant=debug",
    "ios": "react-native run-ios --simulator='iPhone 16 Pro Max'",
    "ios:build": "xcodebuild -workspace ios/MyTeal.xcworkspace -scheme MyTeal -configuration Release -derivedDataPath ios/build",
    "ios:build:dev": "xcodebuild -workspace ios/MyTeal.xcworkspace -scheme MyTeal -configuration Debug -derivedDataPath ios/build",
    "ios:build:dev:simulator": "xcodebuild -workspace ios/MyTeal.xcworkspace -scheme MyTeal -configuration Debug -derivedDataPath ios/build -destination 'platform=iOS Simulator,name=iPhone 14 Pro'",
    "ios:build:dev:simulator:clean": "xcodebuild -workspace ios/MyTeal.xcworkspace -scheme MyTeal -configuration Debug -derivedDataPath ios/build -destination 'platform=iOS Simulator,name=iPhone 14 Pro' clean",
    "ios:build:dev:simulator:clean:archive": "xcodebuild -workspace ios/MyTeal.xcworkspace -scheme MyTeal -configuration Debug -derivedDataPath ios/build -destination 'platform=iOS Simulator,name=iPhone 14 Pro' clean archive",
    "web": "react-native start --web",
    "web:build": "react-native bundle --platform web --dev false --entry-file index.web.js --bundle-output web-build/index.js --assets-dest web-build",
    "web:serve": "serve web-build",
    "web:dev": "react-native start --web --reset-cache",
    "web:dev:build": "react-native bundle --platform web --dev true --entry-file index.web.js --bundle-output web-build/index.js --assets-dest web-build",
    "web:dev:serve": "serve web-build",
    "start": "react-native start --reset-cache",
    "test": "jest",
    "lint:rules": "eslint . --cache",
    "lint:code-format": "prettier --check \"{src,__mocks__}/**/*.{js,json,md,ts,tsx,yml,yaml}\"",
    "lint:type-check": "tsc",
    "lint": "yarn lint:rules && yarn lint:code-format && yarn lint:type-check",
    "lint:fix": "yarn lint:rules --fix && yarn lint:code-format --write && yarn lint:type-check",
    "test:report": "jest --collectCoverage --coverageDirectory=\"./coverage\" --ci --reporters=default --reporters=jest-junit --coverage",
    "pod-install": "npx pod-install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@invertase/react-native-apple-authentication": "^2.4.1",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/datetimepicker": "^8.4.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "^4.5.7",
    "@react-native-firebase/app": "^22.2.0",
    "@react-native-firebase/auth": "^22.2.0",
    "@react-native-firebase/firestore": "^22.2.0",
    "@react-native-google-signin/google-signin": "^14.0.1",
    "@react-native-picker/picker": "^2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.13",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/native-stack": "^7.3.13",
    "@react-navigation/stack": "^7.3.2",
    "@tanstack/react-query": "^5.77.2",
    "axios": "^1.9.0",
    "html-entities": "^2.6.0",
    "immer": "^10.1.1",
    "lottie-react-native": "^7.2.2",
    "lucide-react": "^0.542.0",
    "lucide-react-native": "^0.511.0",
    "moment": "^2.30.1",
    "react": "19.0.0",
    "react-error-boundary": "^6.0.0",
    "react-native": "0.79.2",
    "react-native-background-timer": "^2.4.1",
    "react-native-calendars": "^1.1312.1",
    "react-native-dotenv": "^3.4.11",
    "react-native-dropdown-select-list": "^2.0.5",
